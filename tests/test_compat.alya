# Test suite for backward-compatibility with term_table package
import "std/test"
import "../src/lib.alya" as term

function main()
    test_suite("term Backward Compatibility (term_table) Test Suite")
    let r = runner_new()

    # 1. cell()
    let c1 = term::cell("abc", 6)
    runner_assert_eq(r, len(c1), 6, "cell pads text to target width")
    runner_assert_str_eq(r, c1, "abc   ", "cell pads right with spaces")

    let c_long = term::cell("abcdefghij", 5)
    runner_assert_eq(r, len(c_long), 5, "cell truncates long text")
    runner_assert_str_eq(r, c_long, "ab...", "cell adds ellipsis when truncated")

    let c_colored = term::cell(term::badge("OK", "green"), 6)
    runner_assert_eq(r, term::visible_len(c_colored), 6, "cell pads colored text to exact visible width")

    # 2. box_top, box_mid, box_bot
    let top = term::box_top(4, 6, 8, 10, 5)
    runner_assert(r, len(top) > 0, "box_top generates header border")

    let mid = term::box_mid(4, 6, 8, 10, 5)
    runner_assert(r, len(mid) > 0, "box_mid generates divider border")

    let bot = term::box_bot(4, 6, 8, 10, 5)
    runner_assert(r, len(bot) > 0, "box_bot generates footer border")

    # 3. row()
    let rw = term::row("C1", "C2", "C3", "C4", "C5")
    runner_assert(r, len(rw) > 0, "row generates vertical bar delimited row")

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()
