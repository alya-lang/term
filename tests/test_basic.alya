## Test suite for term package overview and facade
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)
import "std/test"
import "../src/lib.alya" as term

function main()
    test_suite("term Facade & Overview Test Suite")
    let r = runner_new()

    # 1. Colors and Styles
    let red_txt = term::color_red("error")
    runner_assert(r, len(red_txt) > 5, "color_red produces ANSI escape sequence")
    runner_assert_str_eq(r, term::strip_ansi(red_txt), "error", "strip_ansi recovers original text")
    runner_assert_eq(r, term::visible_len(red_txt), 5, "visible_len ignores ANSI escapes")

    # 2. Table Facade
    let t = term::table(["A", "B"], [["1", "2"]])
    let rendered = term::table_render(t)
    runner_assert(r, len(rendered) > 0, "table_render returns non-empty string")
    runner_assert(r, term::visible_len(rendered) > 0, "rendered table has visible text")

    # 3. Callout Box
    let b = term::box_info("All systems operational", "STATUS")
    runner_assert(r, len(b) > 0, "box_info renders callout box")

    # 4. Progress Bar
    let pb = term::progress(50, 100, 20)
    runner_assert(r, len(pb) > 0, "progress returns formatted bar")

    # 5. Horizontal Rules & KV
    let hr_str = term::hr("Overview", 40, "single")
    runner_assert_eq(r, term::visible_len(hr_str), 40, "hr renders exact width")

    # 7. Mini Visualizations
    let sp = term::spark([1, 4, 8, 3, 7])
    runner_assert(r, len(sp) > 0, "spark returns sparkline")

    let b_chart = term::bar("RAM", 64, 128, 16)
    runner_assert(r, len(b_chart) > 0, "bar returns formatted bar chart")

    # 8. Tree Hierarchy
    let tr = term::node("app", [term::leaf("main.alya")])
    let tr_rendered = term::tree(tr)
    runner_assert(r, len(tr_rendered) > 0, "tree facade renders hierarchy")

    # 9. Cursor Controls
    runner_assert_str_eq(r, term::cursor_hide(), "\e[?25l", "cursor_hide generates escape code")

    # 10. v0.0.18 Enums and Struct Methods
    runner_assert_str_eq(r, term::BorderStyle.Unicode, "unicode", "BorderStyle.Unicode is unicode")
    runner_assert_eq(r, term::Alignment.Left, 0, "Alignment.Left is 0")
    runner_assert_eq(r, term::Color.Green, 32, "Color.Green is 32")
    runner_assert_eq(r, term::Style.Bold, 1, "Style.Bold is 1")

    let t_method = term::table(["A", "B"], [["1", "2"]])
    let t_m_out = t_method.render()
    runner_assert(r, len(t_m_out) > 0, "Table.render struct method works")

    let cb_method = term::callout("Content", "Title")
    let cb_m_out = cb_method.render()
    runner_assert(r, len(cb_m_out) > 0, "CalloutBox.render struct method works")

    let pb_method = term::progress_bar_new(100, 20)
    let pb_m_out = pb_method.render(50)
    runner_assert(r, len(pb_m_out) > 0, "ProgressBar.render struct method works")

    let tr_method = term::node("root", [term::leaf("child")])
    let tr_m_out = tr_method.render()
    runner_assert(r, len(tr_m_out) > 0, "TreeNode.render struct method works")

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()
