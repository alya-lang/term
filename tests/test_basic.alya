# Test suite for term package overview and facade
import "std/test"
import "../src/lib.alya" as term

function main()
    test_suite("term Facade & Overview Test Suite")
    let r = runner_new()

    # 1. Colors and Styles
    let red_txt = term::color_red("error")
    runner_assert(r, len(red_txt) > 5, "color_red produces ANSI escape sequence")
    runner_assert_str_eq(r, term::strip_ansi(red_txt), "error", "strip_ansi recovers original text")
    runner_assert_eq(r, term::visible_len(red_txt), 5, "visible_len ignores ANSI escapes")

    # 2. Table Facade
    let t = term::table(["A", "B"], [["1", "2"]])
    let rendered = term::table_render(t)
    runner_assert(r, len(rendered) > 0, "table_render returns non-empty string")
    runner_assert(r, term::visible_len(rendered) > 0, "rendered table has visible text")

    # 3. Callout Box
    let b = term::box_info("All systems operational", "STATUS")
    runner_assert(r, len(b) > 0, "box_info renders callout box")

    # 4. Progress Bar
    let pb = term::progress(50, 100, 20)
    runner_assert(r, len(pb) > 0, "progress returns formatted bar")

    # 5. Backward Compatibility
    let c = term::cell("Hello", 10)
    runner_assert_eq(r, len(c), 10, "cell pads to exact width")

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()
