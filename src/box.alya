## # term/box
##
## Terminal UI toolkit callout box and message banner formatter.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).

import "./types.alya"
import "./style.alya"
import "./border.alya"

## Creates a new `CalloutBox` model with presentation options.
##
## ### Parameters
## - `content`: Box body text (multiline supported).
## - `title`: Optional embedded title. Defaults to `""`.
## - `border_name`: Border preset name. Defaults to `"rounded"`.
## - `color_prefix`: ANSI color prefix. Defaults to `""`.
## - `padding_x`: Horizontal content padding. Defaults to `1`.
## - `min_width`: Minimum content width. Defaults to `0`.
##
## ### Returns
## The new `CalloutBox` instance.
##
## ### Examples
## ```alya
## let b = box_new("Hello", "INFO")
## ```
pub function box_new(content, title: string = "", border_name: string = "rounded", color_prefix: string = "", padding_x: int = 1, min_width: int = 0) -> CalloutBox
    let b_chars = border_get(border_name)
    return CalloutBox { content: content, title: title, box_border_chars: b_chars, box_color_prefix: color_prefix, padding_x: padding_x, min_width: min_width }
end

# Splits text into lines honoring CR, LF, and CRLF endings.
pub function _box_split_lines(text) -> array
    let s = str(text)
    let slen = len(s)
    let res = []
    if slen == 0
        res.push("")
        return res
    end
    let cur = ""
    let i = 0
    while i < slen
        let c = char_at(s, i)
        if c == "\r"
            if i + 1 < slen and char_at(s, i + 1) == "\n"
                i += 1
            end
            res.push(cur)
            cur = ""
        elif c == "\n"
            res.push(cur)
            cur = ""
        else
            cur += c
        end
        i += 1
    end
    res.push(cur)
    return res
end

# Repeats a glyph count times for rule construction.
function _box_repeat(ch: string, count: int) -> string
    if count <= 0
        return ""
    end
    let res = ""
    let i = 0
    while i < count
        res += ch
        i += 1
    end
    return res
end

## Renders a `CalloutBox` into a bordered multiline string.
##
## ### Parameters
## - `cb`: Target `CalloutBox` instance.
##
## ### Returns
## The rendered box string.
pub function box_render(cb: CalloutBox) -> string
    let content_lines = _box_split_lines(cb.content)
    let max_line_w = 0
    for line in content_lines
        let lw = visible_len(line)
        if lw > max_line_w
            max_line_w = lw
        end
    end

    let title_str = str(cb.title)
    let title_vlen = visible_len(title_str)
    let min_content_for_title = 0
    if title_vlen > 0
        min_content_for_title = title_vlen + 2
    end
    if min_content_for_title > max_line_w
        max_line_w = min_content_for_title
    end
    if cb.min_width > max_line_w
        max_line_w = cb.min_width
    end

    let b = cb.box_border_chars
    let col = cb.box_color_prefix
    let reset = ""
    if len(col) > 0
        reset = "\e[0m"
    end

    let pad_w = cb.padding_x
    if pad_w < 0
        pad_w = 0
    end
    let inner_width = max_line_w + (pad_w * 2)

    let out = []

    # 1. Top border (with optional title embedded)
    let top_line = ""
    if title_vlen > 0
        # Format: ╭─ Title ────────╮
        let pre_dashes = 1
        let post_dashes = inner_width - pre_dashes - title_vlen - 2
        if post_dashes < 1
            post_dashes = 1
        end
        top_line = col + b.top_left + _box_repeat(b.horiz, pre_dashes) + reset + " " + title_str + " " + col + _box_repeat(b.horiz, post_dashes) + b.top_right + reset
    else
        top_line = col + b.top_left + _box_repeat(b.horiz, inner_width) + b.top_right + reset
    end
    out.push(top_line)

    # 2. Content lines
    let pad_str = _box_repeat(" ", pad_w)
    for line in content_lines
        let vlen = visible_len(line)
        let trailing_spaces = max_line_w - vlen
        if trailing_spaces < 0
            trailing_spaces = 0
        end
        let row_line = col + b.vert + reset + pad_str + line + _box_repeat(" ", trailing_spaces) + pad_str + col + b.vert + reset
        out.push(row_line)
    end

    # 3. Bottom border
    let bot_line = col + b.bottom_left + _box_repeat(b.horiz, inner_width) + b.bottom_right + reset
    out.push(bot_line)

    # Join with newlines
    let res = ""
    let i = 0
    let total = len(out)
    while i < total
        res += out[i]
        if i < total - 1
            res += "\n"
        end
        i += 1
    end
    return res
end

## Prints a rendered `CalloutBox` to the terminal.
##
## ### Parameters
## - `cb`: Target `CalloutBox` instance.
pub function box_print(cb: CalloutBox)
    say box_render(cb)
end

# ───────────────────────────────────────────────────────────────
# Pre-styled Callout Boxes
# ───────────────────────────────────────────────────────────────

## Renders a cyan `INFO` callout box.
##
## ### Parameters
## - `content`: Box body text.
## - `title`: Embedded title. Defaults to `"INFO"`.
##
## ### Returns
## The rendered box string.
pub function box_info(content, title: string = "INFO") -> string
    let b = box_new(content, title, "rounded", "\e[36m") # Cyan
    return box_render(b)
end

## Renders a green `SUCCESS` callout box.
##
## ### Parameters
## - `content`: Box body text.
## - `title`: Embedded title. Defaults to `"SUCCESS"`.
##
## ### Returns
## The rendered box string.
pub function box_success(content, title: string = "SUCCESS") -> string
    let b = box_new(content, title, "rounded", "\e[32m") # Green
    return box_render(b)
end

## Renders a yellow `WARNING` callout box.
##
## ### Parameters
## - `content`: Box body text.
## - `title`: Embedded title. Defaults to `"WARNING"`.
##
## ### Returns
## The rendered box string.
pub function box_warn(content, title: string = "WARNING") -> string
    let b = box_new(content, title, "rounded", "\e[33m") # Yellow
    return box_render(b)
end

## Renders a red `ERROR` callout box.
##
## ### Parameters
## - `content`: Box body text.
## - `title`: Embedded title. Defaults to `"ERROR"`.
##
## ### Returns
## The rendered box string.
pub function box_error(content, title: string = "ERROR") -> string
    let b = box_new(content, title, "rounded", "\e[31m") # Red
    return box_render(b)
end

# ───────────────────────────────────────────────────────────────
# CalloutBox Struct Methods
# ───────────────────────────────────────────────────────────────

## Renders this box into a bordered multiline string.
##
## ### Parameters
## - `self`: The target `CalloutBox` instance.
##
## ### Returns
## The rendered box string.
pub function CalloutBox.render(self: CalloutBox) -> string
    return box_render(self)
end

## Prints this box to the terminal.
##
## ### Parameters
## - `self`: The target `CalloutBox` instance.
pub function CalloutBox.print(self: CalloutBox)
    box_print(self)
end
