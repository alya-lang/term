## # term/progress
##
## Terminal UI toolkit progress bar and spinner indicators.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).

import "./types.alya"
import "./style.alya"

## Creates a `ProgressBar` model with range and glyph configuration.
##
## Non-positive totals and widths fall back to `1` and `20`.
##
## ### Parameters
## - `total`: Completion target value.
## - `width`: Bar width in cells. Defaults to `30`.
## - `filled_char`: Glyph for completed cells. Defaults to `"="`.
## - `empty_char`: Glyph for remaining cells. Defaults to `" "`.
## - `head_char`: Leading-edge glyph. Defaults to `">"`.
## - `color_prefix`: ANSI color prefix. Defaults to `""`.
##
## ### Returns
## The new `ProgressBar` instance.
pub function progress_bar_new(total: int, width: int = 30, filled_char: string = "=", empty_char: string = " ", head_char: string = ">", color_prefix: string = "") -> ProgressBar
    if total <= 0
        total = 1
    end
    if width <= 0
        width = 20
    end
    return ProgressBar { current: 0, total: total, width: width, filled_char: filled_char, empty_char: empty_char, head_char: head_char, color_prefix: color_prefix, show_percent: 1, show_counts: 1 }
end

# Repeats a glyph count times for bar construction.
function _prog_repeat(ch: string, count: int) -> string
    if count <= 0
        return ""
    end
    let res = ""
    let i = 0
    while i < count
        res += ch
        i += 1
    end
    return res
end

## Renders a progress bar string (`[===========>          ] 55% (55/100)`).
##
## ### Parameters
## - `pb`: Target `ProgressBar` instance (current value is mutated).
## - `current`: Current progress value.
##
## ### Returns
## The rendered bar string.
pub function progress_bar_render(pb: ProgressBar, current: int) -> string
    pb.current = current
    let tot = pb.total
    if tot <= 0
        tot = 1
    end
    let cur = current
    if cur < 0
        cur = 0
    end
    if cur > tot
        cur = tot
    end

    let w = pb.width
    if w <= 0
        w = 20
    end

    let percent = (cur * 100) / tot
    let filled_count = (cur * w) / tot
    if filled_count > w
        filled_count = w
    end

    let head_count = 0
    if len(pb.head_char) > 0 and filled_count < w and cur > 0
        head_count = 1
    end

    let actual_filled = filled_count
    if head_count > 0 and actual_filled > 0
        actual_filled -= 1
    end

    let empty_count = w - actual_filled - head_count
    if empty_count < 0
        empty_count = 0
    end

    let col = pb.color_prefix
    let reset = ""
    if len(col) > 0
        reset = "\e[0m"
    end

    let filled_part = _prog_repeat(pb.filled_char, actual_filled)
    let empty_part = _prog_repeat(pb.empty_char, empty_count)
    let bar = "[{col}{filled_part}"
    if head_count > 0
        bar += pb.head_char
    end
    bar += "{reset}{empty_part}]"

    if pb.show_percent
        bar += " {percent}%"
    end

    if pb.show_counts
        bar += " ({cur}/{tot})"
    end

    return bar
end

## Renders a progress bar without struct instantiation.
##
## ### Parameters
## - `current`: Current progress value.
## - `total`: Completion target value.
## - `width`: Bar width in cells. Defaults to `30`.
##
## ### Returns
## The rendered bar string.
pub function progress_bar(current: int, total: int, width: int = 30) -> string
    let pb = progress_bar_new(total, width)
    return progress_bar_render(pb, current)
end

## Returns an animated spinner glyph for a step and style.
##
## Styles: `"line"`, `"pulse"`, `"arrows"`, `"blocks"`, `"dots"` (default).
##
## ### Parameters
## - `step`: Animation step integer.
## - `style_name`: Spinner style name. Defaults to `"dots"`.
##
## ### Returns
## The spinner glyph string.
pub function spinner_char(step: int, style_name: string = "dots") -> string
    when style_name
        is "line" then
            let frames = ["|", "/", "-", "\\"]
            return frames[step % 4]
        is "pulse" then
            let frames = ["█", "▓", "▒", "░", "▒", "▓"]
            return frames[step % 6]
        is "arrows" then
            let frames = ["←", "↖", "↑", "↗", "→", "↘", "↓", "↙"]
            return frames[step % 8]
        is "blocks" then
            let frames = ["▖", "▘", "▝", "▗"]
            return frames[step % 4]
        else # "dots"
            let frames = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]
            return frames[step % 10]
    end
end

# ───────────────────────────────────────────────────────────────
# ProgressBar Struct Methods
# ───────────────────────────────────────────────────────────────

## Renders this progress bar at the given value.
##
## ### Parameters
## - `self`: The target `ProgressBar` instance.
## - `current`: Current progress value.
##
## ### Returns
## The rendered bar string.
pub function ProgressBar.render(self: ProgressBar, current: int) -> string
    return progress_bar_render(self, current)
end
