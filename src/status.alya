# Terminal UI Toolkit - Status Badges, Loggers & Icons
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "./style.alya"

# --- Unicode Icons ---
pub function icon_success() return "✔" end
pub function icon_warn()    return "⚠" end
pub function icon_error()   return "✖" end
pub function icon_info()    return "ℹ" end
pub function icon_step()    return "➔" end
pub function icon_dot()     return "•" end

# --- Status String Formatters ---

# Returns formatted success message: "✔ [SUCCESS] <msg>"
pub function format_success(msg)
    return color_bright_green(icon_success()) + " " + style_bold(color_bright_green("[SUCCESS]")) + " " + str(msg)
end

# Returns formatted warning message: "⚠ [WARNING] <msg>"
pub function format_warn(msg)
    return color_bright_yellow(icon_warn()) + " " + style_bold(color_bright_yellow("[WARNING]")) + " " + str(msg)
end

# Returns formatted error message: "✖ [ERROR]   <msg>"
pub function format_error(msg)
    return color_bright_red(icon_error()) + " " + style_bold(color_bright_red("[ERROR]  ")) + " " + str(msg)
end

# Returns formatted info message: "ℹ [INFO]    <msg>"
pub function format_info(msg)
    return color_bright_cyan(icon_info()) + " " + style_bold(color_bright_cyan("[INFO]   ")) + " " + str(msg)
end

# Returns formatted step progress message: "➔ [1/3] <msg>"
pub function format_step(current, total, msg)
    let step_str = "[" + str(current) + "/" + str(total) + "]"
    return color_bright_magenta(icon_step()) + " " + style_bold(step_str) + " " + str(msg)
end

# --- Direct Terminal Loggers ---

pub function log_success(msg)
    say format_success(msg)
end

pub function log_warn(msg)
    say format_warn(msg)
end

pub function log_error(msg)
    say format_error(msg)
end

pub function log_info(msg)
    say format_info(msg)
end

pub function log_step(current, total, msg)
    say format_step(current, total, msg)
end
