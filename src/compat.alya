# Terminal UI Toolkit - Backward Compatibility Layer with term_table
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "./style.alya"

function cell(text, width)
    let s = str(text)
    let vlen = visible_len(s)
    if vlen > width
        if width > 3
            return substring(strip_ansi(s), 0, width - 3) + "..."
        else
            return substring(strip_ansi(s), 0, width)
        end
    end
    let diff = width - vlen
    let padding = ""
    let i = 0
    while i < diff
        padding += " "
        i += 1
    end
    return s + padding
end

function _compat_repeat(ch, count)
    let res = ""
    let i = 0
    while i < count
        res += ch
        i += 1
    end
    return res
end

function box_top(w1, w2, w3, w4, w5)
    return "┌" + _compat_repeat("─", w1 + 2) + "┬" + _compat_repeat("─", w2 + 2) + "┬" + _compat_repeat("─", w3 + 2) + "┬" + _compat_repeat("─", w4 + 2) + "┬" + _compat_repeat("─", w5 + 2) + "┐"
end

function box_mid(w1, w2, w3, w4, w5)
    return "├" + _compat_repeat("─", w1 + 2) + "┼" + _compat_repeat("─", w2 + 2) + "┼" + _compat_repeat("─", w3 + 2) + "┼" + _compat_repeat("─", w4 + 2) + "┼" + _compat_repeat("─", w5 + 2) + "┤"
end

function box_bot(w1, w2, w3, w4, w5)
    return "└" + _compat_repeat("─", w1 + 2) + "┴" + _compat_repeat("─", w2 + 2) + "┴" + _compat_repeat("─", w3 + 2) + "┴" + _compat_repeat("─", w4 + 2) + "┴" + _compat_repeat("─", w5 + 2) + "┘"
end

function row(c1, c2, c3, c4, c5)
    return "│ " + str(c1) + " │ " + str(c2) + " │ " + str(c3) + " │ " + str(c4) + " │ " + str(c5) + " │"
end
