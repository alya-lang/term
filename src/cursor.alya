## # term/cursor
##
## Terminal UI toolkit cursor and screen control.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).

# ───────────────────────────────────────────────────────────────
# Cursor Movement
# ───────────────────────────────────────────────────────────────

## Moves the cursor to an absolute 1-indexed row and column.
##
## ### Parameters
## - `row`: Target row integer.
## - `col`: Target column integer.
##
## ### Returns
## The ANSI positioning sequence.
pub function cursor_to(row: int, col: int) -> string
    return "\e[{row};{col}H"
end

## Moves the cursor up by `n` lines.
##
## ### Parameters
## - `n`: Line count. Defaults to `1`.
##
## ### Returns
## The ANSI sequence (empty when `n` is not positive).
pub function cursor_up(n: int = 1) -> string
    if n <= 0
        return ""
    end
    return "\e[{n}A"
end

## Moves the cursor down by `n` lines.
##
## ### Parameters
## - `n`: Line count. Defaults to `1`.
##
## ### Returns
## The ANSI sequence (empty when `n` is not positive).
pub function cursor_down(n: int = 1) -> string
    if n <= 0
        return ""
    end
    return "\e[{n}B"
end

## Moves the cursor forward (right) by `n` columns.
##
## ### Parameters
## - `n`: Column count. Defaults to `1`.
##
## ### Returns
## The ANSI sequence (empty when `n` is not positive).
pub function cursor_forward(n: int = 1) -> string
    if n <= 0
        return ""
    end
    return "\e[{n}C"
end

## Alias for `cursor_forward`.
##
## ### Parameters
## - `n`: Column count. Defaults to `1`.
##
## ### Returns
## The ANSI sequence (empty when `n` is not positive).
pub function cursor_right(n: int = 1) -> string
    return cursor_forward(n)
end

## Moves the cursor back (left) by `n` columns.
##
## ### Parameters
## - `n`: Column count. Defaults to `1`.
##
## ### Returns
## The ANSI sequence (empty when `n` is not positive).
pub function cursor_back(n: int = 1) -> string
    if n <= 0
        return ""
    end
    return "\e[{n}D"
end

## Alias for `cursor_back`.
##
## ### Parameters
## - `n`: Column count. Defaults to `1`.
##
## ### Returns
## The ANSI sequence (empty when `n` is not positive).
pub function cursor_left(n: int = 1) -> string
    return cursor_back(n)
end

## Saves the current cursor position.
##
## ### Returns
## The ANSI save sequence.
pub function cursor_save() -> string
    return "\e[s"
end

## Restores the saved cursor position.
##
## ### Returns
## The ANSI restore sequence.
pub function cursor_restore() -> string
    return "\e[u"
end

## Hides the cursor.
##
## ### Returns
## The ANSI hide sequence.
pub function cursor_hide() -> string
    return "\e[?25l"
end

## Shows the cursor.
##
## ### Returns
## The ANSI show sequence.
pub function cursor_show() -> string
    return "\e[?25h"
end

# ───────────────────────────────────────────────────────────────
# Screen & Line Clearing
# ───────────────────────────────────────────────────────────────

## Clears the terminal screen and resets the cursor to home (`1, 1`).
##
## ### Returns
## The ANSI clear-screen sequence.
pub function clear_screen() -> string
    return "\e[2J\e[H"
end

## Clears the current line entirely, returning to column 0.
##
## ### Returns
## The ANSI clear-line sequence.
pub function clear_line() -> string
    return "\e[2K\r"
end

## Clears from the cursor to the end of the current line.
##
## ### Returns
## The ANSI clear-to-end sequence.
pub function clear_to_end() -> string
    return "\e[K"
end

## Clears from the cursor to the beginning of the current line.
##
## ### Returns
## The ANSI clear-to-start sequence.
pub function clear_to_start() -> string
    return "\e[1K"
end
