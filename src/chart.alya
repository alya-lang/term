## # term/chart
##
## Terminal UI toolkit mini data visualizations (sparklines and bar charts).
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).

import "./style.alya"

# Repeats a glyph count times for bar construction.
function _chart_repeat(ch: string, count: int) -> string
    if count <= 0
        return ""
    end
    let res = ""
    let i = 0
    while i < count
        res += ch
        i += 1
    end
    return res
end

## Generates a sparkline string from an array of numbers.
##
## Uses Unicode block elements (` ▂▃▄▅▆▇█`) scaled to the value range.
##
## ### Parameters
## - `values`: Numeric value array.
## - `min_val`: Explicit range floor (auto-detected when null).
## - `max_val`: Explicit range ceiling (auto-detected when null).
##
## ### Returns
## The sparkline string.
##
## ### Examples
## ```alya
## say sparkline([1, 5, 3, 8, 2])
## ```
pub function sparkline(values: array, min_val = null, max_val = null) -> string
    let v_count = len(values)
    if v_count == 0
        return ""
    end

    let bars = [" ", "▂", "▃", "▄", "▅", "▆", "▇", "█"]

    let actual_min = 0
    let actual_max = 0

    if min_val is not null and max_val is not null
        actual_min = int(min_val)
        actual_max = int(max_val)
    else
        actual_min = int(values[0])
        actual_max = int(values[0])
        let i = 1
        while i < v_count
            let v = int(values[i])
            if v < actual_min
                actual_min = v
            end
            if v > actual_max
                actual_max = v
            end
            i += 1
        end
    end

    let range_val = actual_max - actual_min
    if range_val <= 0
        # All values equal, render mid-level bar
        return _chart_repeat("▄", v_count)
    end

    let res = ""
    let j = 0
    while j < v_count
        let v = int(values[j])
        if v < actual_min
            v = actual_min
        end
        if v > actual_max
            v = actual_max
        end

        let idx = ((v - actual_min) * 7) / range_val
        if idx < 0
            idx = 0
        end
        if idx > 7
            idx = 7
        end

        res += bars[idx]
        j += 1
    end
    return res
end

## Generates a horizontal percentage bar chart.
##
## Example: `"CPU  [████████████░░░░░░░░] 60% (60/100)"`.
##
## ### Parameters
## - `label`: Chart label value.
## - `value`: Current value integer.
## - `max_val`: Range ceiling integer.
## - `width`: Bar width in cells. Defaults to `20`.
## - `fill_char`: Glyph for filled cells. Defaults to `"█"`.
## - `empty_char`: Glyph for remaining cells. Defaults to `"░"`.
##
## ### Returns
## The rendered bar chart string.
pub function bar_chart(label, value: int, max_val: int, width: int = 20, fill_char: string = "█", empty_char: string = "░") -> string
    if max_val <= 0
        max_val = 1
    end
    if value < 0
        value = 0
    end
    if value > max_val
        value = max_val
    end
    if width <= 0
        width = 20
    end

    let pct = (value * 100) / max_val
    let filled_w = (value * width) / max_val
    let empty_w = width - filled_w

    let filled_bar = color_bright_cyan(_chart_repeat(fill_char, filled_w))
    let empty_bar = color_gray(_chart_repeat(empty_char, empty_w))
    let label_str = str(label)
    let lead = ""
    if len(label_str) > 0
        lead = style_bold(label_str) + " "
    end
    let pct_str = style_bold("{pct}%")
    let counts_str = color_gray(" ({value}/{max_val})")

    return "{lead}[{filled_bar}{empty_bar}] {pct_str}{counts_str}"
end
