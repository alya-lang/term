## # term/tree
##
## Terminal UI toolkit tree hierarchy formatting.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).

import "./types.alya"
import "./style.alya"

## Creates a tree node with child nodes.
##
## ### Parameters
## - `label`: Node label value.
## - `children`: Child `TreeNode` array. Defaults to `[]`.
##
## ### Returns
## The new `TreeNode` instance.
pub function tree_node(label, children: array = []) -> TreeNode
    return TreeNode { label: str(label), children: children }
end

## Creates a childless tree leaf node.
##
## ### Parameters
## - `label`: Node label value.
##
## ### Returns
## The new `TreeNode` instance.
pub function tree_leaf(label) -> TreeNode
    let empty_children = []
    return TreeNode { label: str(label), children: empty_children }
end

# Depth-first walker collecting connector-prefixed lines.
function _tree_walk(node: TreeNode, prefix: string, is_last: int, is_root: int, out_lines: array)
    let label = str(node.label)
    let children = node.children

    let next_prefix = prefix
    if is_root == 1
        out_lines.push(label)
    else
        let connector = "├── "
        if is_last == 1
            connector = "└── "
            next_prefix += "    "
        else
            next_prefix += "│   "
        end
        out_lines.push("{prefix}{connector}{label}")
    end

    let c_len = len(children)
    let i = 0
    while i < c_len
        let child = children[i]
        let child_is_last = 0
        if i == c_len - 1
            child_is_last = 1
        end
        _tree_walk(child, next_prefix, child_is_last, 0, out_lines)
        i += 1
    end
end

## Renders a tree into connector-prefixed lines.
##
## ### Parameters
## - `root`: Root `TreeNode` instance.
##
## ### Returns
## The rendered tree string.
pub function tree_render(root: TreeNode) -> string
    let lines = []
    _tree_walk(root, "", 1, 1, lines)
    let res = ""
    let i = 0
    let count = len(lines)
    while i < count
        if i == 0
            res = lines[i]
        else
            res += "\n{lines[i]}"
        end
        i += 1
    end
    return res
end

## Alias for `tree_render`.
##
## ### Parameters
## - `root`: Root `TreeNode` instance.
##
## ### Returns
## The rendered tree string.
pub function tree(root: TreeNode) -> string
    return tree_render(root)
end

# ───────────────────────────────────────────────────────────────
# TreeNode Struct Methods
# ───────────────────────────────────────────────────────────────

## Renders this node into connector-prefixed lines.
##
## ### Parameters
## - `self`: The target `TreeNode` instance.
##
## ### Returns
## The rendered tree string.
pub function TreeNode.render(self: TreeNode) -> string
    return tree_render(self)
end

## Appends a child node, returning the updated parent.
##
## ### Parameters
## - `self`: The target `TreeNode` instance.
## - `child`: Child `TreeNode` to append.
##
## ### Returns
## The updated `TreeNode` instance.
pub function TreeNode.add_child(self: TreeNode, child: TreeNode) -> TreeNode
    self.children.push(child)
    return self
end
