# Terminal UI Toolkit - Border Style Presets
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "./types.alya"

pub function border_unicode()
    return BorderChars("┌", "┬", "┐", "└", "┴", "┘", "├", "┼", "┤", "─", "│")
end

pub function border_rounded()
    return BorderChars("╭", "┬", "╮", "╰", "┴", "╯", "├", "┼", "┤", "─", "│")
end

pub function border_double()
    return BorderChars("╔", "╦", "╗", "╚", "╩", "╝", "╠", "╬", "╣", "═", "║")
end

pub function border_ascii()
    return BorderChars("+", "+", "+", "+", "+", "+", "+", "+", "+", "-", "|")
end

pub function border_markdown()
    return BorderChars("|", "|", "|", "|", "|", "|", "|", "|", "|", "-", "|")
end

pub function border_compact()
    return BorderChars("", "", "", "", "", "", "", "", "", "─", " ")
end

pub function border_none()
    return BorderChars("", "", "", "", "", "", "", "", "", " ", " ")
end

pub function border_get(name)
    when name
        is BorderStyle.Unicode, "unicode" then return border_unicode()
        is BorderStyle.Rounded, "rounded" then return border_rounded()
        is BorderStyle.Double, "double"   then return border_double()
        is BorderStyle.Ascii, "ascii"     then return border_ascii()
        is BorderStyle.Markdown, "markdown" then return border_markdown()
        is BorderStyle.Compact, "compact" then return border_compact()
        is BorderStyle.None, "none"       then return border_none()
        else return border_unicode()
    end
end
