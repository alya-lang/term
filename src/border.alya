## # term/border
##
## Terminal UI toolkit border style presets.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).

import "./types.alya"

## Returns the Unicode single-line border glyph set.
##
## ### Returns
## A `BorderChars` instance with `┌┬┐` corners.
pub function border_unicode() -> BorderChars
    return BorderChars { top_left: "┌", top_mid: "┬", top_right: "┐", bottom_left: "└", bottom_mid: "┴", bottom_right: "┘", mid_left: "├", mid_mid: "┼", mid_right: "┤", horiz: "─", vert: "│" }
end

## Returns the rounded-corner border glyph set.
##
## ### Returns
## A `BorderChars` instance with `╭╮╰╯` corners.
pub function border_rounded() -> BorderChars
    return BorderChars { top_left: "╭", top_mid: "┬", top_right: "╮", bottom_left: "╰", bottom_mid: "┴", bottom_right: "╯", mid_left: "├", mid_mid: "┼", mid_right: "┤", horiz: "─", vert: "│" }
end

## Returns the double-line border glyph set.
##
## ### Returns
## A `BorderChars` instance with `╔╦╗` corners.
pub function border_double() -> BorderChars
    return BorderChars { top_left: "╔", top_mid: "╦", top_right: "╗", bottom_left: "╚", bottom_mid: "╩", bottom_right: "╝", mid_left: "╠", mid_mid: "╬", mid_right: "╣", horiz: "═", vert: "║" }
end

## Returns the ASCII-only border glyph set.
##
## ### Returns
## A `BorderChars` instance using `+`, `-`, and `|`.
pub function border_ascii() -> BorderChars
    return BorderChars { top_left: "+", top_mid: "+", top_right: "+", bottom_left: "+", bottom_mid: "+", bottom_right: "+", mid_left: "+", mid_mid: "+", mid_right: "+", horiz: "-", vert: "|" }
end

## Returns the Markdown-table border glyph set.
##
## ### Returns
## A `BorderChars` instance using pipes and dashes.
pub function border_markdown() -> BorderChars
    return BorderChars { top_left: "|", top_mid: "|", top_right: "|", bottom_left: "|", bottom_mid: "|", bottom_right: "|", mid_left: "|", mid_mid: "|", mid_right: "|", horiz: "-", vert: "|" }
end

## Returns the compact border glyph set (horizontal rules only).
##
## ### Returns
## A `BorderChars` instance with blank corners and space separators.
pub function border_compact() -> BorderChars
    return BorderChars { top_left: "", top_mid: "", top_right: "", bottom_left: "", bottom_mid: "", bottom_right: "", mid_left: "", mid_mid: "", mid_right: "", horiz: "─", vert: " " }
end

## Returns the borderless glyph set.
##
## ### Returns
## A `BorderChars` instance rendering no visible borders.
pub function border_none() -> BorderChars
    return BorderChars { top_left: "", top_mid: "", top_right: "", bottom_left: "", bottom_mid: "", bottom_right: "", mid_left: "", mid_mid: "", mid_right: "", horiz: " ", vert: " " }
end

## Resolves a border preset by enum value or style name.
##
## Unknown names fall back to the Unicode preset.
##
## ### Parameters
## - `name`: `BorderStyle` value or style name string.
##
## ### Returns
## The matching `BorderChars` instance.
##
## ### Examples
## ```alya
## let b = border_get("rounded")
## ```
pub function border_get(name) -> BorderChars
    when name
        is BorderStyle.Unicode, "unicode" then return border_unicode()
        is BorderStyle.Rounded, "rounded" then return border_rounded()
        is BorderStyle.Double, "double"   then return border_double()
        is BorderStyle.Ascii, "ascii"     then return border_ascii()
        is BorderStyle.Markdown, "markdown" then return border_markdown()
        is BorderStyle.Compact, "compact" then return border_compact()
        is BorderStyle.None, "none"       then return border_none()
        else return border_unicode()
    end
end
