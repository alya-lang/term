## # term/table
##
## Terminal UI toolkit dynamic table formatter and builder.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).

import "./types.alya"
import "./style.alya"
import "./border.alya"

# ───────────────────────────────────────────────────────────────
# Table Factory
# ───────────────────────────────────────────────────────────────

## Creates an empty table with a border preset.
##
## ### Parameters
## - `border_style_name`: Border preset name. Defaults to `"unicode"`.
##
## ### Returns
## The new `Table` instance.
pub function table_new(border_style_name: string = "unicode") -> Table
    let b = border_get(border_style_name)
    return Table { headers: [], rows: [], alignments: [], max_widths: [], border_chars: b, show_headers: 1, show_borders: 1, show_separator: 1, padding: 1 }
end

## Creates a table preloaded with headers and rows.
##
## ### Parameters
## - `headers`: Header cell array. Defaults to `[]`.
## - `rows`: Data row array. Defaults to `[]`.
## - `border_style_name`: Border preset name. Defaults to `"unicode"`.
##
## ### Returns
## The new `Table` instance.
pub function table_create(headers: array = [], rows: array = [], border_style_name: string = "unicode") -> Table
    let t = table_new(border_style_name)
    t.headers = headers
    t.rows = rows
    return t
end

# ───────────────────────────────────────────────────────────────
# Table Configuration Setters
# ───────────────────────────────────────────────────────────────

## Replaces the header row, returning the updated table.
##
## ### Parameters
## - `tbl`: Target `Table` instance.
## - `headers`: Header cell array.
##
## ### Returns
## The updated `Table` instance.
pub function table_set_headers(tbl: Table, headers: array) -> Table
    tbl.headers = headers
    return tbl
end

## Appends a data row, returning the updated table.
##
## ### Parameters
## - `tbl`: Target `Table` instance.
## - `row`: Row cell array.
##
## ### Returns
## The updated `Table` instance.
pub function table_add_row(tbl: Table, row: array) -> Table
    tbl.rows.push(row)
    return tbl
end

## Appends multiple data rows, returning the updated table.
##
## ### Parameters
## - `tbl`: Target `Table` instance.
## - `rows`: Array of row cell arrays.
##
## ### Returns
## The updated `Table` instance.
pub function table_add_rows(tbl: Table, rows: array) -> Table
    for row in rows
        tbl.rows.push(row)
    end
    return tbl
end

## Switches the border preset, returning the updated table.
##
## ### Parameters
## - `tbl`: Target `Table` instance.
## - `border_name`: Border preset name.
##
## ### Returns
## The updated `Table` instance.
pub function table_set_border(tbl: Table, border_name: string) -> Table
    tbl.border_chars = border_get(border_name)
    return tbl
end

## Installs a custom border glyph set, returning the updated table.
##
## ### Parameters
## - `tbl`: Target `Table` instance.
## - `border_chars`: Custom `BorderChars` instance.
##
## ### Returns
## The updated `Table` instance.
pub function table_set_border_chars(tbl: Table, border_chars: BorderChars) -> Table
    tbl.border_chars = border_chars
    return tbl
end

## Sets per-column alignments, returning the updated table.
##
## ### Parameters
## - `tbl`: Target `Table` instance.
## - `aligns`: Per-column `Alignment` values.
##
## ### Returns
## The updated `Table` instance.
pub function table_set_alignments(tbl: Table, aligns: array) -> Table
    tbl.alignments = aligns
    return tbl
end

## Sets per-column width caps, returning the updated table.
##
## ### Parameters
## - `tbl`: Target `Table` instance.
## - `max_widths`: Per-column width caps (`0` for uncapped).
##
## ### Returns
## The updated `Table` instance.
pub function table_set_max_widths(tbl: Table, max_widths: array) -> Table
    tbl.max_widths = max_widths
    return tbl
end

## Sets horizontal cell padding, returning the updated table.
##
## ### Parameters
## - `tbl`: Target `Table` instance.
## - `pad`: Padding space count.
##
## ### Returns
## The updated `Table` instance.
pub function table_set_padding(tbl: Table, pad: int) -> Table
    tbl.padding = pad
    return tbl
end

## Toggles header row rendering, returning the updated table.
##
## ### Parameters
## - `tbl`: Target `Table` instance.
## - `show`: `1` renders headers, `0` hides them.
##
## ### Returns
## The updated `Table` instance.
pub function table_set_show_headers(tbl: Table, show: int) -> Table
    tbl.show_headers = show
    return tbl
end

## Toggles outer border rendering, returning the updated table.
##
## ### Parameters
## - `tbl`: Target `Table` instance.
## - `show`: `1` renders borders, `0` hides them.
##
## ### Returns
## The updated `Table` instance.
pub function table_set_show_borders(tbl: Table, show: int) -> Table
    tbl.show_borders = show
    return tbl
end

# ───────────────────────────────────────────────────────────────
# Internal Helper Functions
# ───────────────────────────────────────────────────────────────

function _str_repeat(ch, count)
    if count <= 0
        return ""
    end
    let res = ""
    let i = 0
    while i < count
        res += ch
        i += 1
    end
    return res
end

function _split_lines(text)
    let s = str(text)
    let slen = len(s)
    let res = []
    if slen == 0
        res.push("")
        return res
    end
    let cur = ""
    let i = 0
    while i < slen
        let c = char_at(s, i)
        if c == "\r"
            if i + 1 < slen and char_at(s, i + 1) == "\n"
                i += 1
            end
            res.push(cur)
            cur = ""
        elif c == "\n"
            res.push(cur)
            cur = ""
        else
            cur += c
        end
        i += 1
    end
    res.push(cur)
    return res
end

function _truncate_cell(s, max_len)
    if max_len <= 0
        return ""
    end
    let s_str = str(s)
    let slen = len(s_str)
    let vis = 0
    let cut_idx = 0
    while cut_idx < slen
        let ch = char_at(s_str, cut_idx)
        let ch_vis = visible_len(ch)
        if vis + ch_vis > max_len
            return s_str[0..cut_idx]
        end
        vis += ch_vis
        cut_idx += 1
    end
    return s_str
end

function _calc_column_widths(tbl)
    let widths = []
    let col_count = len(tbl.headers)

    for r in tbl.rows
        if len(r) > col_count
            col_count = len(r)
        end
    end

    if col_count == 0
        return widths
    end

    let c = 0
    while c < col_count
        widths.push(0)
        c += 1
    end

    # Measure header lengths
    if tbl.show_headers
        let hlen = len(tbl.headers)
        c = 0
        while c < hlen
            let sublines = _split_lines(tbl.headers[c])
            for line in sublines
                let w = visible_len(line)
                if w > widths[c]
                    widths[c] = w
                end
            end
            c += 1
        end
    end

    # Measure rows lengths
    for r in tbl.rows
        let row_len = len(r)
        c = 0
        while c < row_len
            let sublines = _split_lines(r[c])
            for line in sublines
                let w = visible_len(line)
                if w > widths[c]
                    widths[c] = w
                end
            end
            c += 1
        end
    end

    return widths
end

function _format_cell(text, target_width, align, pad_spaces)
    let s = str(text)
    let vlen = visible_len(s)
    if vlen > target_width
        if target_width > 3
            s = _truncate_cell(s, target_width - 3) + "..."
            vlen = visible_len(s)
        else
            s = _truncate_cell(s, target_width)
            vlen = visible_len(s)
        end
    end
    let diff = target_width - vlen
    if diff < 0
        diff = 0
    end
    let pad_left_count = 0
    let pad_right_count = 0
    when align
        is Alignment.Center, 1 then # ALIGN_CENTER
            pad_left_count = diff / 2
            pad_right_count = diff - pad_left_count
        is Alignment.Right, 2 then # ALIGN_RIGHT
            pad_left_count = diff
            pad_right_count = 0
        else # ALIGN_LEFT
            pad_left_count = 0
            pad_right_count = diff
    end
    return pad_spaces + _str_repeat(" ", pad_left_count) + s + _str_repeat(" ", pad_right_count) + pad_spaces
end

function _make_border_line(widths, left_ch, mid_ch, right_ch, horiz_ch, pad_size)
    if len(left_ch) == 0 and len(mid_ch) == 0 and len(right_ch) == 0 and len(horiz_ch) == 0
        return ""
    end
    let res = left_ch
    let c = 0
    let col_count = len(widths)
    while c < col_count
        let cell_total_w = widths[c] + (pad_size * 2)
        res += _str_repeat(horiz_ch, cell_total_w)
        if c < col_count - 1
            res += mid_ch
        end
        c += 1
    end
    res += right_ch
    return res
end

# ───────────────────────────────────────────────────────────────
# Main Table Rendering
# ───────────────────────────────────────────────────────────────

## Renders a table into a bordered multiline string.
##
## ### Parameters
## - `tbl`: Target `Table` instance.
##
## ### Returns
## The rendered table string.
pub function table_render(tbl: Table) -> string
    let hlen = len(tbl.headers)
    let rlen = len(tbl.rows)

    if hlen == 0 and rlen == 0
        return ""
    end

    # 1. Compute natural column widths
    let widths = _calc_column_widths(tbl)
    let col_count = len(widths)
    if col_count == 0
        return ""
    end

    # 2. Clamp column widths if max_widths specified
    let mw_len = len(tbl.max_widths)
    if mw_len > 0
        let c = 0
        while c < col_count
            if c < mw_len and tbl.max_widths[c] > 0
                if widths[c] > tbl.max_widths[c]
                    widths[c] = tbl.max_widths[c]
                end
            end
            c += 1
        end
    end

    # Ensure minimum width of 1 per column
    let c = 0
    while c < col_count
        if widths[c] < 1
            widths[c] = 1
        end
        c += 1
    end

    let b = tbl.border_chars
    let pad_str = _str_repeat(" ", tbl.padding)
    let vert_ch = b.vert
    let out_lines = []

    # 3. Render Top Border
    if tbl.show_borders
        let top = _make_border_line(widths, b.top_left, b.top_mid, b.top_right, b.horiz, tbl.padding)
        if len(top) > 0
            out_lines.push(top)
        end
    end

    # 4. Render Headers
    if tbl.show_headers and len(tbl.headers) > 0
        let h_line = vert_ch
        c = 0
        while c < col_count
            let h_val = ""
            if c < hlen
                h_val = str(tbl.headers[c])
            end
            let h_align = 0
            if c < len(tbl.alignments)
                h_align = tbl.alignments[c]
            end
            h_line += _format_cell(h_val, widths[c], h_align, pad_str)
            if len(vert_ch) > 0
                h_line += vert_ch
            end
            c += 1
        end
        out_lines.push(h_line)

        # Separator line between headers and data rows
        if tbl.show_separator
            let sep = _make_border_line(widths, b.mid_left, b.mid_mid, b.mid_right, b.horiz, tbl.padding)
            if len(sep) > 0
                out_lines.push(sep)
            end
        end
    end

    # 5. Render Data Rows (Multi-line cell supported)
    let r = 0
    while r < rlen
        let row = tbl.rows[r]
        let row_cols = len(row)

        # Split all cells into lines
        let cell_sublines = []
        let max_sublines = 1
        c = 0
        while c < col_count
            let raw_cell = ""
            if c < row_cols
                raw_cell = row[c]
            end
            let sub = _split_lines(raw_cell)
            if len(sub) > max_sublines
                max_sublines = len(sub)
            end
            cell_sublines.push(sub)
            c += 1
        end

        # Render each subline of this row
        let s_idx = 0
        while s_idx < max_sublines
            let r_line = vert_ch
            c = 0
            while c < col_count
                let sub_arr = cell_sublines[c]
                let cell_txt = ""
                if s_idx < len(sub_arr)
                    cell_txt = sub_arr[s_idx]
                end
                let c_align = 0
                if c < len(tbl.alignments)
                    c_align = tbl.alignments[c]
                end
                r_line += _format_cell(cell_txt, widths[c], c_align, pad_str)
                if len(vert_ch) > 0
                    r_line += vert_ch
                end
                c += 1
            end
            out_lines.push(r_line)
            s_idx += 1
        end

        r += 1
    end

    # 6. Render Bottom Border
    if tbl.show_borders
        let bot = _make_border_line(widths, b.bottom_left, b.bottom_mid, b.bottom_right, b.horiz, tbl.padding)
        if len(bot) > 0
            out_lines.push(bot)
        end
    end

    # Join lines with newline
    let result = ""
    let line_i = 0
    let total_lines = len(out_lines)
    while line_i < total_lines
        result += out_lines[line_i]
        if line_i < total_lines - 1
            result += "\n"
        end
        line_i += 1
    end
    return result
end

## Prints a rendered table to the terminal.
##
## ### Parameters
## - `tbl`: Target `Table` instance.
pub function table_print(tbl: Table)
    say table_render(tbl)
end

# ───────────────────────────────────────────────────────────────
# Table Struct Methods
# ───────────────────────────────────────────────────────────────

## Replaces the header row, returning the updated table.
##
## ### Parameters
## - `self`: The target `Table` instance.
## - `headers`: Header cell array.
##
## ### Returns
## The updated `Table` instance.
pub function Table.set_headers(self: Table, headers: array) -> Table
    return table_set_headers(self, headers)
end

## Appends a data row, returning the updated table.
##
## ### Parameters
## - `self`: The target `Table` instance.
## - `row`: Row cell array.
##
## ### Returns
## The updated `Table` instance.
pub function Table.add_row(self: Table, row: array) -> Table
    return table_add_row(self, row)
end

## Appends multiple data rows, returning the updated table.
##
## ### Parameters
## - `self`: The target `Table` instance.
## - `rows`: Array of row cell arrays.
##
## ### Returns
## The updated `Table` instance.
pub function Table.add_rows(self: Table, rows: array) -> Table
    return table_add_rows(self, rows)
end

## Switches the border preset, returning the updated table.
##
## ### Parameters
## - `self`: The target `Table` instance.
## - `border_name`: Border preset name.
##
## ### Returns
## The updated `Table` instance.
pub function Table.set_border(self: Table, border_name: string) -> Table
    return table_set_border(self, border_name)
end

## Sets per-column alignments, returning the updated table.
##
## ### Parameters
## - `self`: The target `Table` instance.
## - `aligns`: Per-column `Alignment` values.
##
## ### Returns
## The updated `Table` instance.
pub function Table.set_alignments(self: Table, aligns: array) -> Table
    return table_set_alignments(self, aligns)
end

## Sets per-column width caps, returning the updated table.
##
## ### Parameters
## - `self`: The target `Table` instance.
## - `max_widths`: Per-column width caps (`0` for uncapped).
##
## ### Returns
## The updated `Table` instance.
pub function Table.set_max_widths(self: Table, max_widths: array) -> Table
    return table_set_max_widths(self, max_widths)
end

## Sets horizontal cell padding, returning the updated table.
##
## ### Parameters
## - `self`: The target `Table` instance.
## - `pad`: Padding space count.
##
## ### Returns
## The updated `Table` instance.
pub function Table.set_padding(self: Table, pad: int) -> Table
    return table_set_padding(self, pad)
end

## Toggles header row rendering, returning the updated table.
##
## ### Parameters
## - `self`: The target `Table` instance.
## - `show`: `1` renders headers, `0` hides them.
##
## ### Returns
## The updated `Table` instance.
pub function Table.set_show_headers(self: Table, show: int) -> Table
    return table_set_show_headers(self, show)
end

## Toggles outer border rendering, returning the updated table.
##
## ### Parameters
## - `self`: The target `Table` instance.
## - `show`: `1` renders borders, `0` hides them.
##
## ### Returns
## The updated `Table` instance.
pub function Table.set_show_borders(self: Table, show: int) -> Table
    return table_set_show_borders(self, show)
end

## Renders this table into a bordered multiline string.
##
## ### Parameters
## - `self`: The target `Table` instance.
##
## ### Returns
## The rendered table string.
pub function Table.render(self: Table) -> string
    return table_render(self)
end

## Prints this table to the terminal.
##
## ### Parameters
## - `self`: The target `Table` instance.
pub function Table.print(self: Table)
    table_print(self)
end
