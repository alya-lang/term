# Terminal UI Toolkit - Interactive Console Prompts
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "./style.alya"

# Prompts for text input with optional default value
pub function prompt_text(message, default_val = "")
    let prompt_str = color_cyan("?") + " " + style_bold(message)
    if len(str(default_val)) > 0
        prompt_str += color_gray(" [" + str(default_val) + "]")
    end
    prompt_str += ": "
    let answer = trim(ask(prompt_str))
    if len(answer) == 0 and len(str(default_val)) > 0
        return str(default_val)
    end
    return answer
end

# Asks a confirmation question. Returns 1 for yes, 0 for no.
pub function prompt_confirm(message, default_yes = 1)
    let suffix = " (Y/n): "
    if default_yes == 0
        suffix = " (y/N): "
    end
    let prompt_str = color_yellow("?") + " " + style_bold(message) + color_gray(suffix)
    let resp = lower(trim(ask(prompt_str)))
    if len(resp) == 0
        return default_yes
    end
    when resp
        is "y", "yes", "1", "e", "evet", "true" then return 1
        else return 0
    end
end

# Prompts the user to select one option from a list
pub function prompt_select(message, options, default_idx = 0)
    let opt_count = len(options)
    if opt_count == 0
        return ""
    end
    say color_cyan("?") + " " + style_bold(message)
    let i = 0
    while i < opt_count
        let prefix = "  " + str(i + 1) + ") "
        if i == default_idx
            say color_green(prefix + str(options[i]) + " (default)")
        else
            say color_gray(prefix) + str(options[i])
        end
        i += 1
    end

    let prompt_str = color_gray("Select option [1-" + str(opt_count) + "]: ")
    let raw = trim(ask(prompt_str))
    if len(raw) == 0
        if default_idx >= 0 and default_idx < opt_count
            return str(options[default_idx])
        end
        return str(options[0])
    end

    let choice = int(raw)
    if choice >= 1 and choice <= opt_count
        return str(options[choice - 1])
    end

    # Fallback to default
    if default_idx >= 0 and default_idx < opt_count
        return str(options[default_idx])
    end
    return str(options[0])
end

function _prompt_repeat(ch, count)
    if count <= 0
        return ""
    end
    let res = ""
    let i = 0
    while i < count
        res += ch
        i += 1
    end
    return res
end

# Prompts for password / secret input using ANSI concealment
pub function prompt_password(message, mask = "*")
    let prompt_str = color_yellow("🔒") + " " + style_bold(message) + ": \e[8m"
    let pass = trim(ask(prompt_str))
    say "\e[0m\e[1A\r" + color_yellow("🔒") + " " + style_bold(message) + ": " + color_gray(_prompt_repeat(mask, len(pass)))
    return pass
end

# Prompts for non-empty text input
pub function prompt_non_empty(message, error_msg = "Value cannot be empty.")
    while 1
        let ans = prompt_text(message)
        if len(trim(ans)) > 0
            return ans
        end
        say color_red("  ✖ " + error_msg)
    end
    return ""
end

# Prompts for integer number within range
pub function prompt_int(message, min_val = 0, max_val = 2147483647, default_val = 0)
    let prompt_str = message + " [" + str(min_val) + "-" + str(max_val) + "]"
    while 1
        let raw = prompt_text(prompt_str, default_val)
        let num = int(raw)
        if num >= min_val and num <= max_val
            return num
        end
        say color_red("  ✖ Please enter a number between " + str(min_val) + " and " + str(max_val))
    end
    return default_val
end

# Prompts the user to select multiple options (comma-separated indices)
pub function prompt_multi_select(message, options, default_indices = [])
    let opt_count = len(options)
    if opt_count == 0
        return []
    end
    say color_cyan("?") + " " + style_bold(message) + color_gray(" (comma-separated numbers, e.g. 1, 3)")
    let i = 0
    while i < opt_count
        let is_def = 0
        if i in default_indices
            is_def = 1
        end
        let box = "[ ]"
        if is_def == 1
            box = color_green("[✓]")
        else
            box = color_gray("[ ]")
        end
        say "  " + str(i + 1) + ") " + box + " " + str(options[i])
        i += 1
    end

    let prompt_str = color_gray("Select options [1-" + str(opt_count) + "]: ")
    let raw = trim(ask(prompt_str))
    if len(raw) == 0
        let res = []
        for idx in default_indices
            if idx >= 0 and idx < opt_count
                res.push(options[idx])
            end
        end
        return res
    end

    let parts = split(raw, ",")
    let selected = []
    for item_part in parts
        let item = trim(item_part)
        if len(item) > 0
            let num = int(item)
            if num >= 1 and num <= opt_count
                selected.push(options[num - 1])
            end
        end
    end
    return selected
end
