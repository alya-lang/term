## # term/style
##
## Terminal UI toolkit ANSI styling, colors, and text utilities.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
##
## Delegates rendering to `std/color` while adding ANSI stripping, visual
## width measurement, badges, and tags.

import "std/color" as c
import "./types.alya"

# ───────────────────────────────────────────────────────────────
# Basic Foreground Colors (Delegated to std/color)
# ───────────────────────────────────────────────────────────────

## Wraps text in black foreground.
pub function color_black(s: string) -> string return c::color_black(s) end
## Wraps text in red foreground.
pub function color_red(s: string) -> string return c::color_red(s) end
## Wraps text in green foreground.
pub function color_green(s: string) -> string return c::color_green(s) end
## Wraps text in yellow foreground.
pub function color_yellow(s: string) -> string return c::color_yellow(s) end
## Wraps text in blue foreground.
pub function color_blue(s: string) -> string return c::color_blue(s) end
## Wraps text in magenta foreground.
pub function color_magenta(s: string) -> string return c::color_magenta(s) end
## Wraps text in cyan foreground.
pub function color_cyan(s: string) -> string return c::color_cyan(s) end
## Wraps text in white foreground.
pub function color_white(s: string) -> string return c::color_white(s) end
## Wraps text in gray foreground.
pub function color_gray(s: string) -> string return c::color_gray(s) end

