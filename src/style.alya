# Terminal UI Toolkit - ANSI Styling, Colors, and Text Utilities
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/color" as c

# --- Basic Foreground Colors (Delegated to std/color) ---
function color_black(s) return c::color_black(s) end
function color_red(s) return c::color_red(s) end
function color_green(s) return c::color_green(s) end
function color_yellow(s) return c::color_yellow(s) end
function color_blue(s) return c::color_blue(s) end
function color_magenta(s) return c::color_magenta(s) end
function color_cyan(s) return c::color_cyan(s) end
function color_white(s) return c::color_white(s) end
function color_gray(s) return c::color_gray(s) end

