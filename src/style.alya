function bg_red(s) return c::bg_red(s) end
function bg_green(s) return c::bg_green(s) end
function bg_yellow(s) return c::bg_yellow(s) end
function bg_blue(s) return c::bg_blue(s) end
function bg_magenta(s) return c::bg_magenta(s) end
function bg_cyan(s) return c::bg_cyan(s) end
function bg_white(s) return c::bg_white(s) end

# --- Text Modifiers ---
function style_bold(s) return c::style_bold(s) end
function style_dim(s) return c::style_dim(s) end
function style_italic(s) return c::style_italic(s) end
function style_underline(s) return c::style_underline(s) end
function style_inverse(s) return c::style_inverse(s) end
function style_strikethrough(s) return c::style_strikethrough(s) end

# Aliases
function bold(s) return c::style_bold(s) end
function dim(s) return c::style_dim(s) end
function italic(s) return c::style_italic(s) end
function underline(s) return c::style_underline(s) end

# --- 24-bit TrueColor (RGB) & 256 Colors ---
function color_rgb(s, r, g, b) return c::color_rgb(s, r, g, b) end
function bg_rgb(s, r, g, b) return c::bg_rgb(s, r, g, b) end
function color_256(s, code) return c::color_256(s, code) end
function bg_256(s, code) return c::bg_256(s, code) end
function ansi_reset() return c::ansi_reset() end

# --- Strip ANSI Sequences & Calculate True Visual Length ---
# Strips all ANSI CSI escape sequences (\e[...m, \e[...H, etc.)
function strip_ansi(text)
    return c::ansi_strip(text)
end

# Returns the number of UTF-8 code points / terminal character cells
function utf8_len(s)
    let s_str = str(s)
    let slen = len(s_str)
    if slen == 0
        return 0
    end
    let count = 0
    let i = 0
    while i < slen
        let o = ord(char_at(s_str, i))
        # Count non-continuation bytes (o < 128 for ASCII, o >= 192 for multi-byte leading bytes)
        if o < 128 or o >= 192
            count += 1
        end
        i += 1
    end
    return count
end

function visible_len(text)
    return utf8_len(strip_ansi(text))
end

# --- Badges and Tags ---
function badge(text, color_name = "green")
    when color_name
        is "red" then return style_bold(color_red(text))
        is "green" then return color_green(text)
        is "yellow" then return color_yellow(text)
        is "blue" then return color_blue(text)
        is "cyan" then return color_cyan(text)
        is "magenta" then return color_magenta(text)
        is "gray" then return color_gray(text)
        is "white" then return color_white(text)
        else return text
    end
end

function tag(label, value, color_name = "cyan")
    return "[" + color_gray(label + ": ") + badge(value, color_name) + "]"
end
