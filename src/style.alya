# Terminal UI Toolkit - ANSI Styling, Colors, and Text Utilities
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

function _ansi_esc(code, s)
    return "\e[" + code + "m" + str(s) + "\e[0m"
end

# --- Basic Foreground Colors ---
function color_black(s) return _ansi_esc("30", s) end
function color_red(s) return _ansi_esc("31", s) end
function color_green(s) return _ansi_esc("32", s) end
function color_yellow(s) return _ansi_esc("33", s) end
function color_blue(s) return _ansi_esc("34", s) end
function color_magenta(s) return _ansi_esc("35", s) end
function color_cyan(s) return _ansi_esc("36", s) end
function color_white(s) return _ansi_esc("37", s) end
function color_gray(s) return _ansi_esc("90", s) end

# --- Bright Foreground Colors ---
function color_bright_red(s) return _ansi_esc("91", s) end
function color_bright_green(s) return _ansi_esc("92", s) end
function color_bright_yellow(s) return _ansi_esc("93", s) end
function color_bright_blue(s) return _ansi_esc("94", s) end
function color_bright_magenta(s) return _ansi_esc("95", s) end
function color_bright_cyan(s) return _ansi_esc("96", s) end
function color_bright_white(s) return _ansi_esc("97", s) end

# --- Background Colors ---
function bg_black(s) return _ansi_esc("40", s) end
function bg_red(s) return _ansi_esc("41", s) end
function bg_green(s) return _ansi_esc("42", s) end
function bg_yellow(s) return _ansi_esc("43", s) end
function bg_blue(s) return _ansi_esc("44", s) end
function bg_magenta(s) return _ansi_esc("45", s) end
function bg_cyan(s) return _ansi_esc("46", s) end
function bg_white(s) return _ansi_esc("47", s) end

# --- Text Modifiers ---
function style_bold(s) return _ansi_esc("1", s) end
function style_dim(s) return _ansi_esc("2", s) end
function style_italic(s) return _ansi_esc("3", s) end
function style_underline(s) return _ansi_esc("4", s) end
function style_inverse(s) return _ansi_esc("7", s) end
function style_strikethrough(s) return _ansi_esc("9", s) end

# Aliases
function bold(s) return style_bold(s) end
function dim(s) return style_dim(s) end
function italic(s) return style_italic(s) end
function underline(s) return style_underline(s) end

# --- 24-bit TrueColor (RGB) ---
function color_rgb(s, r, g, b)
    return "\e[38;2;" + str(r) + ";" + str(g) + ";" + str(b) + "m" + str(s) + "\e[0m"
end

function bg_rgb(s, r, g, b)
    return "\e[48;2;" + str(r) + ";" + str(g) + ";" + str(b) + "m" + str(s) + "\e[0m"
end

# --- 256-Color Palette ---
function color_256(s, code)
    return "\e[38;5;" + str(code) + "m" + str(s) + "\e[0m"
end

function bg_256(s, code)
    return "\e[48;5;" + str(code) + "m" + str(s) + "\e[0m"
end

# --- Raw ANSI Codes ---
function ansi_reset() return "\e[0m" end

# --- Strip ANSI Sequences & Calculate True Visual Length ---
# Strips all ANSI CSI escape sequences (\e[...m, \e[...H, etc.)
function strip_ansi(text)
    let s = str(text)
    let slen = len(s)
    if slen == 0
        return ""
    end
    let res = ""
    let i = 0
    while i < slen
        let ch = char_at(s, i)
        if ord(ch) == 27 and i + 1 < slen and char_at(s, i + 1) == "["
            i += 2
            while i < slen
                let c = char_at(s, i)
                let o = ord(c)
                if o >= 64 and o <= 126
                    break
                end
                i += 1
            end
        else
            res += ch
        end
        i += 1
    end
    return res
end

# Returns the number of UTF-8 code points / terminal character cells
function utf8_len(s)
    let s_str = str(s)
    let slen = len(s_str)
    if slen == 0
        return 0
    end
    let count = 0
    let i = 0
    while i < slen
        let o = ord(char_at(s_str, i))
        # Count non-continuation bytes (o < 128 for ASCII, o >= 192 for multi-byte leading bytes)
        if o < 128 or o >= 192
            count += 1
        end
        i += 1
    end
    return count
end

function visible_len(text)
    return utf8_len(strip_ansi(text))
end

# --- Badges and Tags ---
function badge(text, color_name = "green")
    when color_name
        is "red" then return style_bold(color_red(text))
        is "green" then return color_green(text)
        is "yellow" then return color_yellow(text)
        is "blue" then return color_blue(text)
        is "cyan" then return color_cyan(text)
        is "magenta" then return color_magenta(text)
        is "gray" then return color_gray(text)
        is "white" then return color_white(text)
        else return text
    end
end

function tag(label, value, color_name = "cyan")
    return "[" + color_gray(label + ": ") + badge(value, color_name) + "]"
end
