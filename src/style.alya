## Returns the ANSI reset sequence.
pub function ansi_reset() -> string return c::ansi_reset() end

# ───────────────────────────────────────────────────────────────
# Strip ANSI Sequences & Calculate True Visual Length
# ───────────────────────────────────────────────────────────────

## Strips all ANSI CSI escape sequences (`\e[...m`, `\e[...H`, etc.).
##
## ### Parameters
## - `text`: Annotated string.
##
## ### Returns
## The plain string without escape sequences.
pub function strip_ansi(text: string) -> string
    return c::ansi_strip(text)
end

## Returns the visual terminal cell width of a UTF-8 string.
##
## Accounts for ASCII (width 1), CJK/wide characters (width 2), and 4-byte
## emojis (width 2).
##
## ### Parameters
## - `s`: Input value coerced to a string.
##
## ### Returns
## The visual cell width integer.
##
## ### Examples
## ```alya
## say utf8_len("Alya") # 4
## ```
pub function utf8_len(s) -> int
    let s_str = str(s)
    let slen = len(s_str)
    if slen == 0
        return 0
    end
    let count = 0
    let i = 0
    while i < slen
        let o = ord(char_at(s_str, i))
        when o
            is < 128 then
                # Printable ASCII
                if o >= 32 and o < 127
                    count += 1
                end
            is 192..223 then
                # 2-byte UTF-8 (Latin extended, Greek, Cyrillic, etc.) -> 1 cell
                count += 1
                if i + 1 < slen
                    i += 1
                end
            is 224..239 then
                # 3-byte UTF-8: decode code point
                if i + 2 < slen
                    let b1 = ord(char_at(s_str, i + 1)) - 128
                    let b2 = ord(char_at(s_str, i + 2)) - 128
                    let cp = (o - 224) * 4096 + b1 * 64 + b2
                    # Wide CJK, Hangul, Fullwidth forms -> 2 cells
                    if (cp >= 4352 and cp <= 4447) or (cp >= 11904 and cp <= 42191) or (cp >= 44032 and cp <= 55203) or (cp >= 63744 and cp <= 64255) or (cp >= 65040 and cp <= 65049) or (cp >= 65072 and cp <= 65135) or (cp >= 65281 and cp <= 65376) or (cp >= 65504 and cp <= 65510)
                        count += 2
                    # Common 3-byte Emojis -> 2 cells
                    elif (cp >= 9200 and cp <= 9203) or cp == 9208 or cp == 9209 or (cp >= 9888 and cp <= 9889) or (cp >= 9917 and cp <= 9918) or cp == 9970 or cp == 9971 or cp == 9973 or cp == 9978 or cp == 9989 or cp == 9992 or cp == 9993 or (cp >= 9994 and cp <= 9996) or cp == 10024 or cp == 10060 or cp == 10062 or (cp >= 10067 and cp <= 10071) or cp == 10084 or (cp >= 10133 and cp <= 10135) or cp == 11088 or cp == 11093
                        count += 2
                    else
                        count += 1
                    end
                    i += 2
                else
                    count += 1
                    i = slen
                end
            is 240..255 then
                # 4-byte UTF-8: emojis (🧬, 🐍, 🎮, etc.) & CJK extensions -> 2 cells
                count += 2
                if i + 3 < slen
                    i += 3
                else
                    i = slen
                end
        end
        i += 1
    end
    return count
end

## Returns the visual width of a string after stripping ANSI sequences.
##
## ### Parameters
## - `text`: Annotated string.
##
## ### Returns
## The visual cell width integer.
pub function visible_len(text: string) -> int
    return utf8_len(strip_ansi(text))
end

# ───────────────────────────────────────────────────────────────
# Badges and Tags
# ───────────────────────────────────────────────────────────────

## Colors text by `Color` enum value or color name.
##
## Unknown names return the text unchanged.
##
## ### Parameters
## - `text`: Text to color.
## - `color_name`: `Color` value or name string. Defaults to `"green"`.
##
## ### Returns
## The colorized string.
##
## ### Examples
## ```alya
## say badge("OK", "green")
## ```
pub function badge(text: string, color_name = "green") -> string
    when color_name
        is Color.Red, "red" then return style_bold(color_red(text))
        is Color.Green, "green" then return color_green(text)
        is Color.Yellow, "yellow" then return color_yellow(text)
        is Color.Blue, "blue" then return color_blue(text)
        is Color.Cyan, "cyan" then return color_cyan(text)
        is Color.Magenta, "magenta" then return color_magenta(text)
        is Color.Gray, "gray" then return color_gray(text)
        is Color.White, "white" then return color_white(text)
        else return text
    end
end

## Formats a `[label: value]` tag with a colored value badge.
##
## ### Parameters
## - `label`: Tag label string.
## - `value`: Tag value string.
## - `color_name`: Badge color name or `Color` value. Defaults to `"cyan"`.
##
## ### Returns
## The formatted tag string.
pub function tag(label: string, value: string, color_name = "cyan") -> string
    let key_part = color_gray("{label}: ")
    let val_part = badge(value, color_name)
    return "[{key_part}{val_part}]"
end
