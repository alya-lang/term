# Terminal UI Toolkit - Type & Constant Definitions
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

pub enum BorderStyle
    Unicode = "unicode"
    Rounded = "rounded"
    Double = "double"
    Ascii = "ascii"
    Markdown = "markdown"
    Compact = "compact"
    None = "none"
end

pub enum Alignment
    Left = 0
    Center = 1
    Right = 2
end

pub enum Color
    Black = 30
    Red = 31
    Green = 32
    Yellow = 33
    Blue = 34
    Magenta = 35
    Cyan = 36
    White = 37
    Default = 39
    Gray = 90
    BrightRed = 91
    BrightGreen = 92
    BrightYellow = 93
    BrightBlue = 94
    BrightMagenta = 95
    BrightCyan = 96
    BrightWhite = 97
end

pub enum Style
    Bold = 1
    Dim = 2
    Italic = 3
    Underline = 4
    Inverse = 7
    Strikethrough = 9
end

pub struct BorderChars
    top_left
    top_mid
    top_right
    bottom_left
    bottom_mid
    bottom_right
    mid_left
    mid_mid
    mid_right
    horiz
    vert
end

pub struct Table
    headers
    rows
    alignments
    max_widths
    border_chars
    show_headers
    show_borders
    show_separator
    padding
end

pub struct TermTable
    headers
    rows
    alignments
    max_widths
    border_chars
    show_headers
    show_borders
    show_separator
    padding
end

pub struct CalloutBox
    content
    title
    box_border_chars
    box_color_prefix
    padding_x
    min_width
end

pub struct ProgressBar
    current
    total
    width
    filled_char
    empty_char
    head_char
    color_prefix
    show_percent
    show_counts
end

pub struct TreeNode
    label
    children
end
